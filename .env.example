# Postgres connection string. On Vercel + Neon, use the POOLED url (host contains "-pooler").
# Local example: postgresql://postgres:postgres@localhost:5432/hopline
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Optional: direct (non-pooled) url used only for migrations. The Neon Vercel integration sets this automatically.
DATABASE_URL_UNPOOLED=""

# Optional: secret salt for hashing visitor IPs into short-lived rate-limit keys. Use a long random string.
HASH_SALT=""

# Optional: force the public origin used in short links (e.g. a custom domain). Leave empty to use the request's host.
NEXT_PUBLIC_APP_URL=""

# Optional: link creations allowed per visitor per window (defaults: 20 per 600 seconds).
RATE_LIMIT_MAX=""
RATE_LIMIT_WINDOW_SECONDS=""

# Optional: max Postgres connections per serverless instance (default 5).
DATABASE_POOL_MAX=""
